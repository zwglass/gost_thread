  miner_prefix="$(config_prefix "${miner}")"
  host_key="${prefix}_${miner_prefix}_TARGET_HOST"
  port_key="${prefix}_${miner_prefix}_TARGET_PORT"
  prepare_atomic_update
  if (( clear == 1 )); then
    grep -Ev "^(${host_key}|${port_key})=" "${PROFILES_FILE}" >"${TEMP_FILE}"
  else
    PROFILE_ENDPOINT_HOST_KEY="${host_key}" \
    PROFILE_ENDPOINT_PORT_KEY="${port_key}" \
