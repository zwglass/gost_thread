        lines[2] = ENVIRON["PROFILE_ENDPOINT_PORT_LINE"]
      }
      {
        equal = index($0, "=")
        key = equal ? substr($0, 1, equal - 1) : ""
        for (i = 1; i <= 2; i++) {
          if (key == keys[i]) {
            if (!seen[i]) print lines[i]
            seen[i] = 1
            next
          }
        }
        print
      }
      END {
        for (i = 1; i <= 2; i++) {
          if (!seen[i]) print lines[i]
        }
      }
    ' "${PROFILES_FILE}" >"${TEMP_FILE}"
  fi
  commit_atomic_update
  if (( clear == 1 )); then
    echo "Cleared endpoint: ${name}/${miner}"
  else
    echo "Updated endpoint: ${name}/${miner}"
  fi
}

cmd_validate() {
  local wanted="${1:-}"
  local prefix
  local name
  local failures=0
  local checked=0

  [[ "$#" -le 1 ]] || die "Usage: $0 profiles validate [profile]"
  load_profiles
  if [[ -n "${wanted}" ]]; then
    validate_profile_name "${wanted}"
    name="$(canonical_profile_name "${wanted}")"
    prefix="$(config_prefix "${name}")"
    profile_exists "${prefix}" || die "Profile not found: ${name}"
    if ! validate_profile_data "${prefix}" "${name}"; then
      failures=$((failures + 1))
    fi
    checked=1
  else
    while IFS= read -r prefix; do
      [[ -n "${prefix}" ]] || continue
      name="$(canonical_profile_name "${prefix}")"
      if ! validate_profile_data "${prefix}" "${name}"; then
        failures=$((failures + 1))
      fi
      checked=$((checked + 1))
    done < <(profile_names)
  fi

  (( checked > 0 )) || die "No profiles found in ${PROFILES_FILE}."
  (( failures == 0 )) || die "Profile validation failed: ${failures} profile(s) with errors."
  echo "Validated ${checked} profile(s): ${PROFILES_FILE}"
}

cmd_use() {
  local name=""
  local miner=""
  local prefix
  local supported
  local default_miner
  local target_host
  local target_port
  local extra_args=()

  if [[ "$#" -gt 0 && "$1" != --* ]]; then
    name="$1"
    shift
  fi
  while [[ "$#" -gt 0 ]]; do
    case "$1" in
      --miner)
        [[ "$#" -ge 2 ]] || die "Missing value for --miner."
        miner="$2"
        shift 2
        ;;
      --miner=*)
        miner="${1#*=}"
        shift
        ;;
      --miner-arg)
        [[ "$#" -ge 2 ]] || die "Missing value for --miner-arg."
        extra_args+=("$2")
        shift 2
        ;;
      --miner-arg=*)
        extra_args+=("${1#*=}")
        shift
        ;;
      -h | --help)
        usage
        exit 0
        ;;
      *)
        die "Unknown option for profiles use: $1"
        ;;
    esac
  done

  [[ -n "${name}" ]] || die "Usage: $0 profiles use <profile> [--miner <miner>]"
  validate_profile_name "${name}"
  name="$(canonical_profile_name "${name}")"
  prefix="$(config_prefix "${name}")"
  load_profiles
  profile_exists "${prefix}" || die "Profile not found: ${name}"
  supported="$(profile_value "${prefix}" SUPPORTED_MINERS)"
  default_miner="$(profile_value "${prefix}" DEFAULT_MINER)"
  target_host="$(profile_value "${prefix}" TARGET_HOST)"
  target_port="$(profile_value "${prefix}" TARGET_PORT)"
  miner="${miner:-${default_miner}}"
  validate_miner_name "${miner}"
  contains_word "${supported}" "${miner}" || \
    die "Miner ${miner} is not supported by profile ${name}."
  validate_registered_miner "${miner}"
  [[ -n "${target_host}" ]] || die "Profile has no target host: ${name}"
  validate_port "${target_port}"
  [[ -f "${CLIENT_FILE}" ]] || die "Missing related config: ${CLIENT_FILE}"
  [[ -f "${MINERS_FILE}" ]] || die "Missing related config: ${MINERS_FILE}"

  GOST_THREAD_CONFIG_DIR="${CONFIG_DIR}" \
  GOST_THREAD_RESTART_SERVICES="${GOST_THREAD_RESTART_SERVICES:-0}" \
  GOST_THREAD_MANAGE_KRIG_REDIRECT="${GOST_THREAD_MANAGE_KRIG_REDIRECT:-0}" \
    "${ROOT_DIR}/scripts/switch_profile.sh" \
    --pool "${name}" --miner "${miner}" "${extra_args[@]}"
}

main() {
  local command="${1:-}"
  local subcommand

  if [[ -z "${command}" || "${command}" == "-h" || "${command}" == "--help" ]]; then
    usage
    return 0
  fi
  case "${command}" in
    profile | profiles) ;;
    *)
      die "Unknown command: ${command}
Run '$0 --help' for usage."
      ;;
  esac

  shift
  subcommand="${1:-}"
  if [[ -z "${subcommand}" || "${subcommand}" == "-h" || "${subcommand}" == "--help" ]]; then
    profiles_usage
    return 0
  fi
  shift

  case "${subcommand}" in
    list)
      cmd_list "$@"
      ;;
    show)
      [[ "$#" -le 1 ]] || die "Usage: $0 profiles show <profile>"
      cmd_show "${1:-}"
      ;;
    view)
      [[ "$#" -le 1 ]] || die "Usage: $0 profiles view [profile]"
      if [[ "$#" -eq 0 ]]; then cmd_list; else cmd_show "$1"; fi
      ;;
    add | create)
      cmd_add "$@"
      ;;
    update)
      cmd_update "$@"
      ;;
    remove | delete | rm)
      cmd_remove "$@"
      ;;
    remove-profile | delete-profile | remove-pool)
      [[ "$#" -eq 1 ]] || die "Usage: $0 profiles remove-profile <profile>"
      cmd_remove_profile "$1"
      ;;
    set-args | set-miner-args)
      cmd_set_args "$@"
      ;;
    clear-args | unset-args)
      cmd_set_args "$@" --clear
      ;;
    set-endpoint | set-miner-endpoint)
      cmd_set_endpoint "$@"
      ;;
    clear-endpoint | unset-endpoint)
      cmd_set_endpoint "$@" --clear
      ;;
    validate)
      cmd_validate "$@"
      ;;
    use | switch | apply)
      cmd_use "$@"
      ;;
    *)
      die "Unknown profiles command: ${subcommand}
Run '$0 profiles --help' for usage."
      ;;
  esac
}

main "$@"
