WORKER_NAME=rtx3090
WALLET_ADDRESS=prl1p22pq5hnskyrpysvtx8yqayq8vurrrfu0jzmyeqtjxs7r75k8jvuqpqspma
NOCKCHAIN_ADDRESS=42tDL3WjX9XTnR1PUfgjUjFLndQvftqUT77PTgVjjKRMx6XSDqbYe98

LUCKYPOOL_TARGET_HOST=pearl-eu1.luckypool.io
LUCKYPOOL_TARGET_PORT=3360
LUCKYPOOL_DEFAULT_MINER=lpminer
LUCKYPOOL_SUPPORTED_MINERS="lpminer"

ALPHAPOOL_TARGET_HOST=eu1.alphapool.tech
ALPHAPOOL_TARGET_PORT=5566
ALPHAPOOL_DEFAULT_MINER=alpha-miner
ALPHAPOOL_SUPPORTED_MINERS="alpha-miner"

PEARLHASH_TARGET_HOST=pool.pearlhash.xyz
PEARLHASH_TARGET_PORT=9000
PEARLHASH_DEFAULT_MINER='wildrig'
PEARLHASH_SUPPORTED_MINERS='wildrig'

# gost-thread profile: pearlfortune
PEARLFORTUNE_TARGET_HOST='global.pearlfortune.org'
PEARLFORTUNE_TARGET_PORT='443'
PEARLFORTUNE_DEFAULT_MINER='pearlfortune'
PEARLFORTUNE_SUPPORTED_MINERS='pearlfortune'

HEROMINERS_TARGET_HOST=de.pearl.herominers.com
HEROMINERS_TARGET_PORT=1200
HEROMINERS_DEFAULT_MINER=peakminer
HEROMINERS_SUPPORTED_MINERS="peakminer"

KRYPTEX_TARGET_HOST=prl-eu.kryptex.network
KRYPTEX_TARGET_PORT=7048
KRYPTEX_DEFAULT_MINER=srbminer
KRYPTEX_SUPPORTED_MINERS="srbminer peakminer krig-miner onezerominer"

# Krig Miner supports TLS-only pool connections.  Its encrypted connection is
# passed unchanged through the local GOST TCP forwarder to this endpoint.
KRYPTEX_KRIG_MINER_TARGET_HOST=prl.kryptex.network
KRYPTEX_KRIG_MINER_TARGET_PORT=8048

# Bash argument arrays, selected by <POOL>_<MINER>_ARGS (hyphens become underscores).
# Runtime placeholders are replaced after endpoint overrides are applied:
# {LOCAL_ADDRESS}, {TARGET_HOST}, {TARGET_PORT}. Quote each argument separately.
# Shell variables expand when this file is sourced; no command string is evaluated.

LUCKYPOOL_LPMINER_ARGS=(
  --algo pearl
  --pool 'stratum+tcp://{LOCAL_ADDRESS}'
  --wallet "${WALLET_ADDRESS}+mdl1pgsyjwlla6vaqfp428s2ltf78zhh3kkklx8rmvehxpa6dph8kghrskygxsh"
  --worker "${WORKER_NAME}"
)

ALPHAPOOL_ALPHA_MINER_ARGS=(
  --pool 'stratum+tcp://{LOCAL_ADDRESS}'
  --address "${WALLET_ADDRESS}"
  --worker "${WORKER_NAME}"
  --password "x;d=262144;mdl=mdl1pgsyjwlla6vaqfp428s2ltf78zhh3kkklx8rmvehxpa6dph8kghrskygxsh"
)

PEARLHASH_WILDRIG_ARGS=(
  --algo pearl
  --url 'stratum+tcp://{LOCAL_ADDRESS}'
  --user "${WALLET_ADDRESS}"
  --worker "${WORKER_NAME}"
)


PEARLFORTUNE_PEARLFORTUNE_ARGS=(
  --proxy '{LOCAL_ADDRESS}'
  --address '${WALLET_ADDRESS}'
  --worker '${WORKER_NAME}'
  -gpu
)

HEROMINERS_PEAKMINER_ARGS=(
  --url '{LOCAL_ADDRESS}'
  --user "${WALLET_ADDRESS}.${WORKER_NAME}"
)

KRYPTEX_SRBMINER_ARGS=(
  --disable-cpu
  --algorithm pearlhash
  --pool '{LOCAL_ADDRESS}'
  --wallet "${WALLET_ADDRESS}.${WORKER_NAME}"
  --password x
)

KRYPTEX_PEAKMINER_ARGS=(
  --url '{LOCAL_ADDRESS}'
  --user "${WALLET_ADDRESS}.${WORKER_NAME}"
  --coin pearl
)

KRYPTEX_KRIG_MINER_ARGS=(
  --url 'stratum+ssl://{TARGET_HOST}:{TARGET_PORT}'
  --user "${WALLET_ADDRESS}/${WORKER_NAME}"
  --password x
)

KRYPTEX_ONEZEROMINER_ARGS=(
  --algo pearlhash
  --pool "stratum+tcp://{LOCAL_ADDRESS}"
  --wallet "${WALLET_ADDRESS}.${WORKER_NAME}"

)
